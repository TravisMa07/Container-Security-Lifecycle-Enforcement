{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:csle:contracts:v1:compliance-evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "framework",
    "framework_version",
    "control_id",
    "mapping_version",
    "technical_check_id",
    "technical_procedure",
    "assessment",
    "applicability",
    "asset_scope",
    "observed_at",
    "evidence_ids",
    "limitations",
    "reference_url",
    "source_review_id",
    "reviewer"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "framework": {
      "enum": [
        "CIS_KUBERNETES",
        "NIST_SP_800_53",
        "PCI_DSS"
      ]
    },
    "framework_version": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/id"
    },
    "control_id": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/id"
    },
    "mapping_version": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/id"
    },
    "technical_check_id": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/id"
    },
    "technical_procedure": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/text"
    },
    "assessment": {
      "enum": [
        "pass_technical_check",
        "fail_technical_check",
        "requires_review",
        "insufficient_evidence",
        "not_applicable_with_justification"
      ]
    },
    "applicability": {
      "enum": [
        "applicable",
        "not_determined",
        "not_applicable"
      ]
    },
    "applicability_justification": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/text"
    },
    "asset_scope": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/text"
    },
    "observed_at": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/utc"
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 0,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:csle:contracts:v1:common#/$defs/id"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "urn:csle:contracts:v1:common#/$defs/text"
      }
    },
    "reference_url": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/https"
    },
    "source_review_id": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/id"
    },
    "reviewer": {
      "anyOf": [
        {
          "$ref": "urn:csle:contracts:v1:common#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "assessment": {
            "enum": [
              "pass_technical_check",
              "fail_technical_check"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "applicability": {
            "const": "applicable"
          },
          "evidence_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "applicability": {
            "const": "not_determined"
          }
        }
      },
      "then": {
        "properties": {
          "assessment": {
            "enum": [
              "requires_review",
              "insufficient_evidence"
            ]
          }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "assessment": {
                "const": "not_applicable_with_justification"
              }
            }
          },
          {
            "properties": {
              "applicability": {
                "const": "not_applicable"
              }
            }
          }
        ]
      },
      "then": {
        "required": [
          "applicability_justification"
        ],
        "properties": {
          "assessment": {
            "const": "not_applicable_with_justification"
          },
          "applicability": {
            "const": "not_applicable"
          }
        }
      }
    }
  ],
  "$comment": "Framework versions/URLs/source_review_id are claims to be checked against source-reviewed release mappings and actual evidence. This schema never establishes organizational compliance, CDE scope or correct control applicability."
}
