{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:csle:contracts:v1:security-predicate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "predicate_type",
    "subject_image_digest",
    "assessment_id",
    "decision",
    "policy_id",
    "policy_version",
    "policy_hash",
    "scan_result_hash",
    "scanner_version",
    "scan_timestamp",
    "scanner_db_updated_at",
    "issued_at",
    "timestamp",
    "expires_at",
    "signer_identity",
    "reason_codes",
    "evidence_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "predicate_type": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/https"
    },
    "subject_image_digest": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/digest"
    },
    "assessment_id": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/id"
    },
    "decision": {
      "enum": [
        "allow",
        "deny",
        "review_required"
      ]
    },
    "policy_id": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/id"
    },
    "policy_version": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/id"
    },
    "policy_hash": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/digest"
    },
    "scan_result_hash": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/digest"
    },
    "scanner_version": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/id"
    },
    "scan_timestamp": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/utc"
    },
    "scanner_db_updated_at": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/utc"
    },
    "issued_at": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/utc"
    },
    "timestamp": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/utc"
    },
    "expires_at": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/utc"
    },
    "signer_identity": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/id"
    },
    "reason_codes": {
      "$ref": "urn:csle:contracts:v1:common#/$defs/reasons"
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "urn:csle:contracts:v1:common#/$defs/id"
      }
    }
  },
  "$comment": "Content schema only: actual Cosign/in-toto subject/signature verification and trusted independent scan/policy checks are mandatory. timestamp equals issued_at, issue < expiry, scan/DB freshness and active policy are domain invariants."
}
